<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_teacher_assignment_tree" model="ir.ui.view">
        <field name="name">school.teacher.assignment.tree</field>
        <field name="model">school.teacher.assignment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="teacher_id"/>
                <field name="subject_id"/>
                <field name="class_id"/>
                <field name="academic_year"/>
                <field name="term"/>
                <field name="responsibility"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_school_teacher_assignment_form" model="ir.ui.view">
        <field name="name">school.teacher.assignment.form</field>
        <field name="model">school.teacher.assignment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="subject_id"/>
                            <field name="class_id"/>
                            <field name="academic_year"/>
                            <field name="term"/>
                        </group>
                        <group>
                            <field name="teacher_id"
                                   context="{'assignment_academic_year': academic_year, 'assignment_term': term}"/>
                            <field name="responsibility"/>
                            <field name="weekly_periods"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_school_teacher_assignment_search" model="ir.ui.view">
        <field name="name">school.teacher.assignment.search</field>
        <field name="model">school.teacher.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="teacher_id"/>
                <field name="subject_id"/>
                <field name="class_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Term" name="group_term" context="{'group_by': 'term'}"/>
                    <filter string="Responsibility" name="group_responsibility" context="{'group_by': 'responsibility'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_assignment" model="ir.actions.act_window">
        <field name="name">Teacher Assignments</field>
        <field name="res_model">school.teacher.assignment</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
