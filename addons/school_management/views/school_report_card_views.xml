<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Card Wizard Action -->
    <record id="action_school_report_card_generate" model="ir.actions.act_window">
        <field name="name">Generate Report Card</field>
        <field name="res_model">school.report.card.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Report Card Search View -->
    <record id="view_school_report_card_search" model="ir.ui.view">
        <field name="name">school.report.card.search</field>
        <field name="model">school.report.card</field>
        <field name="arch" type="xml">
            <search string="Search Report Cards">
                <field name="name"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="term_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Published" name="published" domain="[('state', '=', 'published')]"/>
                <filter string="Superseded" name="superseded" domain="[('state', '=', 'superseded')]"/>
                <separator/>
                <filter string="Class" name="group_by_class" context="{'group_by': 'class_id'}"/>
                <filter string="Term" name="group_by_term" context="{'group_by': 'term_id'}"/>
                <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- Report Card List View -->
    <record id="view_school_report_card_list" model="ir.ui.view">
        <field name="name">school.report.card.list</field>
        <field name="model">school.report.card</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <header>
                    <button name="%(action_school_report_card_generate)d" type="action" string="Generate Report Card" class="btn-primary" display="always" groups="school_management.group_school_admin,school_management.group_school_exam_officer"/>
                </header>
                <field name="name"/>
                <field name="student_id"/>
                <field name="term_id"/>
                <field name="class_id"/>
                <field name="version"/>
                <field name="overall_average" string="Overall Average (%)"/>
                <field name="class_rank" optional="show"/>
                <field name="grade_rank" optional="hide"/>
                <field name="result"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Report Card Form View -->
    <record id="view_school_report_card_form" model="ir.ui.view">
        <field name="name">school.report.card.form</field>
        <field name="model">school.report.card</field>
        <field name="arch" type="xml">
            <form string="Report Card" create="0">
                <header>
                    <button name="action_approve" string="Approve" type="object" invisible="state != 'draft'" class="oe_highlight" groups="school_management.group_school_exam_officer,school_management.group_school_admin"/>
                    <button name="action_publish" string="Publish" type="object" invisible="state != 'approved'" class="oe_highlight" groups="school_management.group_school_exam_officer,school_management.group_school_admin"/>
                    <button name="%(action_report_school_report_card)d" string="Print PDF" type="action" invisible="state not in ('approved', 'published')" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Student Information">
                            <field name="student_id" readonly="1"/>
                            <field name="enrollment_id" readonly="1"/>
                            <field name="class_id" readonly="1"/>
                            <field name="academic_year_id" readonly="1"/>
                            <field name="term_id" readonly="1"/>
                        </group>
                        <group string="Academic Performance">
                            <field name="grading_scheme_id" readonly="1"/>
                            <field name="overall_average" readonly="1"/>
                            <field name="result" readonly="1"/>
                            <field name="class_rank" readonly="1"/>
                            <field name="class_size" readonly="1"/>
                            <field name="grade_rank" readonly="1"/>
                            <field name="grade_size" readonly="1"/>
                            <field name="version" readonly="1"/>
                            <field name="supersedes_id" readonly="1" invisible="not supersedes_id"/>
                            <field name="superseded_by_id" readonly="1" invisible="not superseded_by_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Report Card Main Action -->
    <record id="action_school_report_card" model="ir.actions.act_window">
        <field name="name">Report Cards</field>
        <field name="res_model">school.report.card</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_report_card_search"/>
    </record>
</odoo>