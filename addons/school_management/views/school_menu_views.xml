<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- School Management — Menus -->
    <!-- One submenu section per role. Each menuitem carries a groups= attribute
         so users only see sections their role permits.
         Load order: always loaded last in __manifest__.py. -->

    <!-- ROOT -->
    <menuitem id="menu_school_root"
              name="School"
              web_icon="school_management,static/description/icon.svg"
              sequence="10"/>

    <!-- ADMIN -->
    <menuitem id="menu_school_overview"
              name="Overview"
              parent="menu_school_root"
              action="action_school_overview_server"
              groups="school_management.group_school_admin"
              sequence="1"/>

    <menuitem id="menu_school_administration"
              name="Administration"
              parent="menu_school_root"
              groups="school_management.group_school_admin"
              sequence="90"/>

    <menuitem id="menu_school_room"
              name="Rooms"
              parent="menu_school_administration"
              action="action_school_room"
              groups="school_management.group_school_admin"
              sequence="10"/>

    <menuitem id="menu_school_campus"
              name="Branches / Campuses"
              parent="menu_school_administration"
              action="action_school_campus"
              groups="school_management.group_school_admin"
              sequence="20"/>

    <!-- DIRECTOR -->
    <menuitem id="menu_school_director"
              name="Director"
              parent="menu_school_root"
              groups="school_management.group_school_director"
              sequence="15"/>

    <menuitem id="menu_school_director_overview"
              name="School Overview"
              parent="menu_school_director"
              action="action_school_overview_server"
              groups="school_management.group_school_director"
              sequence="10"/>

    <menuitem id="menu_school_analysis"
              name="Analysis"
              parent="menu_school_director"
              groups="school_management.group_school_director"
              sequence="20"/>

    <menuitem id="menu_school_dashboard_results"
              name="Results Analysis"
              parent="menu_school_analysis"
              action="action_school_dashboard_results"
              groups="school_management.group_school_director"
              sequence="10"/>

    <menuitem id="menu_school_dashboard_attendance"
              name="Attendance Analysis"
              parent="menu_school_analysis"
              action="action_school_dashboard_attendance"
              groups="school_management.group_school_director"
              sequence="20"/>

    <menuitem id="menu_school_dashboard_workload"
              name="Teacher Workload"
              parent="menu_school_analysis"
              action="action_school_dashboard_workload"
              groups="school_management.group_school_director"
              sequence="30"/>

    <!-- REGISTRAR -->
    <menuitem id="menu_school_registrar"
              name="Registrar"
              parent="menu_school_root"
              groups="school_management.group_school_registrar,school_management.group_school_exam_officer"
              sequence="20"/>

    <menuitem id="menu_school_admission_wizard"
              name="Student Registration"
              parent="menu_school_registrar"
              action="action_school_admission_wizard"/>

    <menuitem id="menu_school_assessment"
              name="Assessments"
              parent="menu_school_registrar"
              action="action_school_assessment"
              groups="school_management.group_school_registrar,school_management.group_school_exam_officer"
              sequence="33"/>
              
    <!-- (rest of your menuitems unchanged) -->
</odoo>
