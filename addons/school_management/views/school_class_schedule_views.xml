<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_class_schedule_tree" model="ir.ui.view">
        <field name="name">school.class.schedule.tree</field>
        <field name="model">school.class.schedule</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="day_of_week"/>
                <field name="date" optional="show"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="class_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="room_id"/>
                <field name="schedule_type" optional="hide"/>
                <field name="academic_year_id" optional="hide"/>
                <field name="term_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-danger="state == 'cancelled'"
                       decoration-warning="state == 'rescheduled'"/>
            </list>
        </field>
    </record>

    <record id="view_school_class_schedule_form" model="ir.ui.view">
        <field name="name">school.class.schedule.form</field>
        <field name="model">school.class.schedule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" string="Publish" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_complete" string="Mark Completed" type="object"
                            invisible="state not in ['published', 'rescheduled']"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['cancelled', 'completed']"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,completed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Academic Period">
                            <field name="class_id"/>
                            <field name="section_id" invisible="not section_id"/>
                            <field name="academic_year_id"/>
                            <field name="term_id"/>
                        </group>
                        <group string="Class">
                            <field name="subject_id"/>
                            <field name="teacher_id"/>
                            <field name="schedule_type"/>
                            <field name="room_id"/>
                        </group>
                        <group string="When">
                            <field name="day_of_week"/>
                            <field name="date"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                        </group>
                        <group string="Control">
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Instructions or replacement information."/>
                        </page>
                        <page string="Rescheduling" invisible="state != 'rescheduled'">
                            <field name="reschedule_reason"
                                   placeholder="Why was this class moved? The previous day, date, and times stay in the log below."
                                   required="state == 'rescheduled'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_class_schedule_calendar" model="ir.ui.view">
        <field name="name">school.class.schedule.calendar</field>
        <field name="model">school.class.schedule</field>
        <field name="arch" type="xml">
            <!-- Dated sessions only. Recurring weekday slots have no date, so use the
                 "Weekly Timetable" list grouped by day for those. -->
            <calendar date_start="date" color="teacher_id" mode="month" quick_create="0">
                <field name="subject_id"/>
                <field name="class_id"/>
                <field name="teacher_id"/>
                <field name="room_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_school_class_schedule_search" model="ir.ui.view">
        <field name="name">school.class.schedule.search</field>
        <field name="model">school.class.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="teacher_id"/>
                <field name="subject_id"/>
                <field name="class_id"/>
                <field name="room_id"/>
                <field name="academic_year_id"/>
                <filter string="Published" name="published" domain="[('state', '=', 'published')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Rescheduled" name="rescheduled" domain="[('state', '=', 'rescheduled')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Recurring Weekly" name="recurring" domain="[('date', '=', False)]"/>
                <filter string="One-off Session" name="one_off" domain="[('date', '!=', False)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter string="Day of Week" name="group_day" context="{'group_by': 'day_of_week'}"/>
                    <filter string="Teacher" name="group_teacher" context="{'group_by': 'teacher_id'}"/>
                    <filter string="Class / Section" name="group_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Subject" name="group_subject" context="{'group_by': 'subject_id'}"/>
                    <filter string="Room" name="group_room" context="{'group_by': 'room_id'}"/>
                    <filter string="Term" name="group_term" context="{'group_by': 'term_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_class_schedule" model="ir.actions.act_window">
        <field name="name">Class Schedule</field>
        <field name="res_model">school.class.schedule</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule the first class period.
            </p>
        </field>
    </record>

    <record id="action_school_weekly_timetable" model="ir.actions.act_window">
        <field name="name">Weekly Timetable</field>
        <field name="res_model">school.class.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('date', '=', False)]</field>
        <field name="context">{'search_default_group_day': 1, 'search_default_published': 1}</field>
    </record>
</odoo>
