<odoo>
    <!-- The enrollment form button references this action, so it loads first. -->
    <record id="view_school_enrollment_transfer_form" model="ir.ui.view">
        <field name="name">school.enrollment.transfer.form</field>
        <field name="model">school.enrollment.transfer</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="enrollment_id" options="{'no_create': True}"/>
                    <field name="new_class_id" options="{'no_create': True}"/>
                    <field name="effective_date"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Transfer" class="oe_highlight"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_school_enrollment_transfer" model="ir.actions.act_window">
        <field name="name">Section Transfer</field>
        <field name="res_model">school.enrollment.transfer</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_school_enrollment_tree" model="ir.ui.view">
        <field name="name">school.enrollment.tree</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="academic_year_id"/>
                <field name="roll_number"/>
                <field name="admission_type"/>
                <field name="state"/>
                <button name="action_open_student_dashboard"
                        type="object"
                        string="View Dashboard"
                        class="btn-link"
                        icon="fa-id-card"/>
            </list>
        </field>
    </record>

    <record id="view_school_enrollment_form" model="ir.ui.view">
        <field name="name">school.enrollment.form</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" type="object" string="Activate" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="%(action_school_enrollment_transfer)d" type="action" string="Transfer" invisible="state != 'active'"
                            groups="school_management.group_school_registrar"
                            context="{'default_enrollment_id': id}"/>
                    <button name="action_withdraw" type="object" string="Withdraw" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <group>
                        <group string="Placement">
                            <field name="name" readonly="1"/>
                            <field name="student_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="class_id" options="{'no_create': True}"/>
                            <field name="academic_year_id"/>
                            <field name="roll_number" readonly="state != 'draft'"/>
                        </group>
                        <group string="Dates">
                            <field name="admission_type"/>
                            <field name="enrollment_date"/>
                            <field name="end_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Subjects">
                        <field name="subject_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="grade_subject_id" domain="[('class_id', '=', parent.class_id)]" options="{'no_create': True}"/>
                                <field name="subject_type"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_enrollment_search" model="ir.ui.view">
        <field name="name">school.enrollment.search</field>
        <field name="model">school.enrollment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <group name="group_by">
                    <filter name="group_class" string="Class" context="{'group_by': 'class_id'}"/>
                    <filter name="group_year" string="Academic Year" context="{'group_by': 'academic_year_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">school.enrollment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

</odoo>
