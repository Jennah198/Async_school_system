<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        School Management — Record Rules (Row-Level Access)
        ====================================================
        Odoo ORs all rules a user qualifies for.
        Each role gets its own narrow rule; Admin inherits all via implied_ids
        and automatically passes every rule through.

        Rule naming: <model>: <what the rule allows> for <role>
    -->

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!--  STAFF                                                                -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->

    <!-- Registrar sees all staff records -->
    <record id="rule_staff_all_registrar" model="ir.rule">
        <field name="name">Staff: all records — Registrar</field>
        <field name="model_id" ref="model_school_staff"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_registrar'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Director sees all staff records (read-only enforced at model level) -->
    <record id="rule_staff_all_director" model="ir.rule">
        <field name="name">Staff: all records — Director</field>
        <field name="model_id" ref="model_school_staff"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_director'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!--  STUDENTS                                                             -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->

    <!-- Registrar: unrestricted — manages all student records -->
    <record id="rule_student_all_registrar" model="ir.rule">
        <field name="name">Students: all records — Registrar</field>
        <field name="model_id" ref="model_school_student"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_registrar'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Director: all records, read-only (model level enforces no write) -->
    <record id="rule_student_all_director" model="ir.rule">
        <field name="name">Students: all records — Director</field>
        <field name="model_id" ref="model_school_student"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_director'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Teacher: only students in own assigned classes -->
    <record id="rule_student_own_classes_teacher" model="ir.rule">
        <field name="name">Students: own classes only — Teacher</field>
        <field name="model_id" ref="model_school_student"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="domain_force">[('class_id', 'in', user.school_taught_class_ids.ids)]</field>
    </record>

    <!-- Front Office: can look up students by name/contact — all rows visible,
         field-level groups on sensitive columns restrict what they see -->
    <record id="rule_student_contact_frontoffice" model="ir.rule">
        <field name="name">Students: all rows (contact lookup) — Front Office</field>
        <field name="model_id" ref="model_school_student"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_frontoffice'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!--  ATTENDANCE                                                           -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->

    <!-- Registrar: full access to all attendance records -->
    <record id="rule_attendance_all_registrar" model="ir.rule">
        <field name="name">Attendance: all records — Registrar</field>
        <field name="model_id" ref="model_school_attendance"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_registrar'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Director: all records, read-only -->
    <record id="rule_attendance_all_director" model="ir.rule">
        <field name="name">Attendance: all records — Director</field>
        <field name="model_id" ref="model_school_attendance"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_director'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Teacher: only attendance records for own assigned classes -->
    <record id="rule_attendance_own_classes_teacher" model="ir.rule">
        <field name="name">Attendance: own classes only — Teacher</field>
        <field name="model_id" ref="model_school_attendance"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="domain_force">[('class_id', 'in', user.school_taught_class_ids.ids)]</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!--  MARKS                                                                -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->

    <!-- Registrar: full access to all mark records -->
    <record id="rule_mark_all_registrar" model="ir.rule">
        <field name="name">Marks: all records — Registrar</field>
        <field name="model_id" ref="model_school_mark"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_registrar'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Director: all records, read-only -->
    <record id="rule_mark_all_director" model="ir.rule">
        <field name="name">Marks: all records — Director</field>
        <field name="model_id" ref="model_school_mark"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_director'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Teacher: only marks for own assigned class AND subject -->
    <record id="rule_mark_own_class_subject_teacher" model="ir.rule">
        <field name="name">Marks: own class and subject only — Teacher</field>
        <field name="model_id" ref="model_school_mark"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="domain_force">['&amp;',
            ('class_id', 'in', user.school_taught_class_ids.ids),
            ('subject_id', 'in', user.school_taught_subject_ids.ids)
        ]</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!--  CLASS SCHEDULE                                                       -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->

    <!-- Registrar: manage all schedules -->
    <record id="rule_schedule_all_registrar" model="ir.rule">
        <field name="name">Class schedule: all records — Registrar</field>
        <field name="model_id" ref="model_school_class_schedule"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_registrar'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Teacher: only own slots -->
    <record id="rule_schedule_own_teacher" model="ir.rule">
        <field name="name">Class schedule: own slots — Teacher</field>
        <field name="model_id" ref="model_school_class_schedule"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="domain_force">[('teacher_id', '=', user.school_teacher_id.id)]</field>
    </record>

    <!-- Director: all schedules, read-only -->
    <record id="rule_schedule_all_director" model="ir.rule">
        <field name="name">Class schedule: all records — Director</field>
        <field name="model_id" ref="model_school_class_schedule"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_director'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!--  ANNOUNCEMENTS                                                        -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->

    <!-- Registrar: manage all announcements -->
    <record id="rule_announcement_all_registrar" model="ir.rule">
        <field name="name">Announcements: all records — Registrar</field>
        <field name="model_id" ref="model_school_announcement"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_registrar'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Front Office: create/edit announcements they authored -->
    <record id="rule_announcement_own_frontoffice" model="ir.rule">
        <field name="name">Announcements: own as author — Front Office</field>
        <field name="model_id" ref="model_school_announcement"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_frontoffice'))]"/>
        <field name="domain_force">[('author_id', '=', user.id)]</field>
    </record>

    <!-- Teacher: read published announcements targeted at them -->
    <record id="rule_announcement_published_teacher" model="ir.rule">
        <field name="name">Announcements: published only — Teacher</field>
        <field name="model_id" ref="model_school_announcement"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="domain_force">[('is_live', '=', True)]</field>
    </record>

    <!-- Director: all announcements, read-only -->
    <record id="rule_announcement_all_director" model="ir.rule">
        <field name="name">Announcements: all records — Director</field>
        <field name="model_id" ref="model_school_announcement"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_director'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!--  PROGRAMS                                                             -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->

    <!-- Registrar: manage all programs -->
    <record id="rule_program_all_registrar" model="ir.rule">
        <field name="name">Programs: all records — Registrar</field>
        <field name="model_id" ref="model_school_program"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_registrar'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Teacher: only programs they are involved in -->
    <record id="rule_program_own_teacher" model="ir.rule">
        <field name="name">Programs: own involvement — Teacher</field>
        <field name="model_id" ref="model_school_program"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_teacher'))]"/>
        <field name="domain_force">['|',
            ('teacher_ids', 'in', user.school_teacher_id.ids),
            '&amp;', ('state', '!=', 'draft'), ('audience_type', '=', 'all_staff')
        ]</field>
    </record>

    <!-- Director: all programs, read-only -->
    <record id="rule_program_all_director" model="ir.rule">
        <field name="name">Programs: all records — Director</field>
        <field name="model_id" ref="model_school_program"/>
        <field name="groups" eval="[(4, ref('school_management.group_school_director'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
